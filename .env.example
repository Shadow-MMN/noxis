# Starknet mainnet RPC (free key from https://www.alchemy.com)
# Copy this file to .env.local and replace the placeholder. Never commit .env.local.
NEXT_PUBLIC_ALCHEMY_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>

# AVNU paymaster key for private swaps (Portal key from https://portal.avnu.fi).
# Server-side only — the API route proxies it; never expose it to the browser.
AVNU_PAYMASTER_API_KEY=<YOUR_AVNU_PAYMASTER_API_KEY>
